# ─────────────────────────────────────────────────────────────
# Cubito API · variables de entorno
# Copia este archivo a backend/.env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# PostgreSQL (RDS en AWS)
# Ejemplo local:
DATABASE_URL="postgresql://cubito:cubito@localhost:5432/cubito?schema=public"
# Ejemplo RDS (usa sslmode=require en producción):
# DATABASE_URL="postgresql://cubito:TU_PASSWORD@tu-rds.amazonaws.com:5432/cubito?schema=public&sslmode=require"

# Genera uno con: openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
JWT_SESSION_EXPIRES_IN=12h
JWT_REMEMBER_EXPIRES_IN=30d

# Orígenes permitidos, separados por coma (sin barra final)
CORS_ORIGINS=http://localhost:3000

# Datos del seed inicial (solo se usan al ejecutar `npm run seed`)
SEED_ALEX_EMAIL=alex@cubito.local
SEED_SANDRA_EMAIL=sandra@cubito.local
SEED_PASSWORD=CambiarEstaClave123!

# Peticiones máximas por IP en la ventana de login
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_MINUTES=15
